# ==============================================================================
# ArchitectureNext LMS Backend Environment Variables
# Copy this file to backend/.env and populate with your environment credentials.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
APP_URL="https://www.architecturenext.in" # or http://localhost:5000 in local dev

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/Architecturenext?schema=public"

# JWT Authentication (Required - Must be a strong, unpredictable random secret)
JWT_SECRET="your-super-strong-jwt-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Frontend Web Application URL (CORS & Redirects)
FRONTEND_URL="http://localhost:5173"

# Razorpay Payment Gateway Credentials (Test or Production)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_optional"

# SMTP Mail Server Credentials (For 6-Digit OTP Verification & Password Resets)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-notification-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="\"ArchitectureNext\" <noreply@architecturenext.in>"
