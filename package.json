{
    "name":  "skillspring-backend",
    "version":  "1.0.0",
    "description":  "SkillSpring LMS REST API Backend with PostgreSQL and Prisma",
    "main":  "server.js",
    "type":  "module",
    "scripts":  {
                    "build":  "prisma generate \u0026\u0026 prisma db push --accept-data-loss",
                    "start":  "node server.js",
                    "dev":  "node --watch-path=src --watch-path=server.js server.js",
                    "postinstall":  "prisma generate",
                    "prisma:generate":  "prisma generate",
                    "prisma:migrate":  "prisma migrate dev",
                    "prisma:push":  "prisma db push",
                    "prisma:seed":  "node prisma/seed.js",
                    "prisma:studio":  "prisma studio",
                    "export:data":  "node scripts/export-data.js",
                    "import:data":  "node scripts/import-data.js"
                },
    "dependencies":  {
                         "@aws-sdk/client-s3":  "^3.1138.0",
                         "@aws-sdk/s3-request-presigner":  "^3.1138.0",
                         "@ffmpeg-installer/ffmpeg":  "^1.1.0",
                         "@prisma/client":  "^6.4.0",
                         "bcryptjs":  "^3.0.2",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "express-rate-limit":  "^8.6.2",
                         "fluent-ffmpeg":  "^2.1.3",
                         "helmet":  "^8.0.0",
                         "jsonwebtoken":  "^9.0.2",
                         "morgan":  "^1.10.0",
                         "multer":  "^2.2.0",
                         "nodemailer":  "^9.0.5",
                         "prisma":  "^6.4.0",
                         "zod":  "^3.24.2"
                     }
}
